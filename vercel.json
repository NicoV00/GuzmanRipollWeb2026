{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/inicio", "destination": "/", "permanent": true },
    { "source": "/cir-mamaria", "destination": "/procedimientos/cirugia-mamaria", "permanent": true },
    { "source": "/procedimiento/01", "destination": "/procedimientos/cirugia-mamaria", "permanent": true },
    { "source": "/procedimiento/02", "destination": "/procedimientos/lipoescultura-vaser", "permanent": true },
    { "source": "/procedimiento/04", "destination": "/procedimientos/abdominoplastia", "permanent": true },
    { "source": "/procedimiento/06", "destination": "/procedimientos/tratamientos-no-invasivos", "permanent": true },
    { "source": "/procedimiento/:path*", "destination": "/procedimientos", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
